<?xml version="1.0"?><Container version="2"><Name>tidal-playlist-bridge</Name><Repository>tidal-playlist-bridge:0.4.3</Repository><Network>bridge</Network><WebUI>http://[IP]:[PORT:8090]/</WebUI><Project>https://github.com/jonpastore/music-recommendations</Project><Overview>Imports TIDAL playlists and posts compact artist/album lists to Discord. It can submit confirmed historical listens to ListenBrainz.</Overview><Config Name="Web UI port" Target="8090" Default="8090" Mode="tcp" Description="Web interface port" Type="Port" Display="always" Required="true" Mask="false"/><Config Name="App data" Target="/config" Default="/mnt/user/appdata/tidal-playlist-bridge/config" Mode="rw" Description="TIDAL OAuth session and local configuration" Type="Path" Display="always" Required="true" Mask="false"/><Config Name="Discord webhook" Target="DISCORD_WEBHOOK_URL" Default="" Mode="" Description="Discord incoming-webhook URL" Type="Variable" Display="always" Required="true" Mask="true"/><Config Name="ListenBrainz username" Target="LISTENBRAINZ_USERNAME" Default="" Mode="" Description="Used to fetch recommendation playlists" Type="Variable" Display="always" Required="false" Mask="false"/><Config Name="ListenBrainz token" Target="LISTENBRAINZ_TOKEN" Default="" Mode="" Description="Used only for confirmed historical listens" Type="Variable" Display="always" Required="false" Mask="true"/></Container>
