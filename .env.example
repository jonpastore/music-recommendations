# Required for Discord posting
DISCORD_WEBHOOK_URL=
# ListenBrainz account receiving confirmed listens and Pandora scrobbles
LISTENBRAINZ_USERNAME=
LISTENBRAINZ_TOKEN=

# Spotify: use Connect Spotify or supply an existing refresh token
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8090/api/spotify/callback
SPOTIFY_REFRESH_TOKEN=

# YouTube Music: Google OAuth client type TVs and Limited Input devices
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Optional alternative: path inside the container to ytmusicapi browser auth JSON
YOUTUBE_MUSIC_AUTH_FILE=

# Pandora listens already scrobbled to ListenBrainz (no Pandora password/API key)
# Leave blank to use LISTENBRAINZ_USERNAME
PANDORA_LISTENBRAINZ_USERNAME=
PANDORA_HISTORY_LIMIT=200

# Set true when using an HTTPS reverse proxy, even if its upstream is HTTP
OAUTH_COOKIE_SECURE=false
